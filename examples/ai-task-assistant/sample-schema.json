{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/matchgrid/action-plan-draft-v1.json",
  "title": "ActionPlanDraft",
  "description": "Fictional MatchGrid example — AI-assisted structured plan before human confirm.",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspaceId", "draftId", "originalIntent", "goalStatement", "steps"],
  "properties": {
    "workspaceId": {
      "type": "string",
      "description": "Opaque workspace identifier."
    },
    "draftId": {
      "type": "string",
      "description": "Correlation id for the non-persistent draft."
    },
    "originalIntent": {
      "type": "string",
      "maxLength": 8000,
      "description": "User's vague task text."
    },
    "goalStatement": {
      "type": "string",
      "maxLength": 2000,
      "description": "Single sentence reframing the outcome."
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "action"],
        "properties": {
          "order": { "type": "integer", "minimum": 1 },
          "action": { "type": "string", "maxLength": 1000 },
          "estimatedEffort": {
            "type": "string",
            "enum": ["S", "M", "L", "unknown"]
          },
          "dependsOnStepOrders": {
            "type": "array",
            "items": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "openQuestions": {
      "type": "array",
      "items": { "type": "string", "maxLength": 500 }
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string", "maxLength": 500 }
    },
    "disclaimer": {
      "type": "string",
      "description": "Optional UX disclaimer that output is AI-generated.",
      "maxLength": 500
    }
  }
}
